# ─── Database ──────────────────────────────────────
DB_NAME=freelanceflow
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ─── Email (Gmail SMTP) ────────────────────────────
# Step 1: Enable 2-Step Verification on your Google account
# Step 2: Go to Google Account > Security > App Passwords
# Step 3: Generate a password for "Mail" and paste below

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=yourname@gmail.com
EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx
DEFAULT_FROM_EMAIL=FreelanceFlow <yourname@gmail.com>

# ─── Django ────────────────────────────────────────
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
SITE_URL=http://localhost:8000

# ─── Redis / Celery ────────────────────────────────
# Install Redis: https://redis.io/docs/getting-started/
REDIS_URL=redis://localhost:6379/0

# ─── Optional: Stripe (for online payments) ────────
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
