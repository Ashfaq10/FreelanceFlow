# Copy to `.env` in the repo root. backend/config/settings/base.py loads it via python-dotenv,
# and docker-compose.yml mounts it into every backend container.

# ─── Django ────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Database ──────────────────────────────────────────────
# Local dev: USE_SQLITE=True stores data in ./db.sqlite3 (no Postgres needed).
USE_SQLITE=True
# config.settings.local reads the DB_* values when USE_SQLITE=False.
DB_NAME=freelanceflow
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
# config.settings.production reads DATABASE_URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/freelanceflow

# ─── Redis / Celery ────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Email ─────────────────────────────────────────────────
# Local dev: leave EMAIL_HOST_USER empty to print emails to the console.
# To send real mail locally (e.g. Gmail SMTP with an App Password), fill these in:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=FreelanceFlow <invoices@example.com>
# Production sends through SendGrid SMTP using this key.
SENDGRID_API_KEY=

# ─── Stripe (optional) ─────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── AWS S3 (production only; local dev uses ./media) ──────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=freelanceflow-pdfs
AWS_S3_REGION_NAME=us-east-1
