# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://user:password@localhost:5432/freelanceflow
# Or use individual settings:
DB_NAME=freelanceflow
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Use SQLite instead of PostgreSQL for local development (set to True)
USE_SQLITE=False

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SendGrid (Email)
SENDGRID_API_KEY=SG...
DEFAULT_FROM_EMAIL=invoices@yourdomain.com

# AWS S3 (optional in dev — uses local storage by default)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=freelanceflow-pdfs
AWS_S3_REGION_NAME=us-east-1

# App
SITE_URL=http://localhost:8000
