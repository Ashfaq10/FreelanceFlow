# Copy to .env.prod (git-ignored). Used by docker-compose.prod.yml for every service.
# Production settings refuse to boot without SECRET_KEY and ALLOWED_HOSTS.

# Public domain: Caddy requests a Let's Encrypt certificate for it. `localhost` = local test.
SITE_ADDRESS=app.example.com
SECRET_KEY=generate-with-python-c-"import secrets; print(secrets.token_urlsafe(50))"
ALLOWED_HOSTS=app.example.com
SITE_URL=https://app.example.com
FRONTEND_URL=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
# Same origin as the SPA, so CORS can stay empty.
CORS_ALLOWED_ORIGINS=

# Postgres: the db container reads POSTGRES_*, Django reads DATABASE_URL; keep them in sync.
POSTGRES_DB=freelanceflow
POSTGRES_USER=freelanceflow
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://freelanceflow:change-me@db:5432/freelanceflow
REDIS_URL=redis://redis:6379/0

# Production sends mail through SendGrid SMTP and stores logos/PDFs on S3 (see .env.example).
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Webhook endpoint: https://<SITE_ADDRESS>/api/payments/webhook/
STRIPE_WEBHOOK_SECRET=

# ─── Error tracking (optional; empty = off) ────────────────
# VITE_SENTRY_DSN is a build arg of the proxy image; compose reads it from this file.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_DSN=
