# One origin for SPA and API: no CORS, and the auth token never crosses sites.
# SITE_ADDRESS is the public domain (Caddy gets a Let's Encrypt certificate for it);
# `localhost` uses Caddy's local CA. Caddy sets X-Forwarded-Proto/-For for Django itself.
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	# The SPA hosts pages that must not be framed: delete account, accepting a quote, paying.
	header {
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	@backend path /api/* /admin/* /static/*
	handle @backend {
		reverse_proxy {$BACKEND_ADDR:web:8000}
	}

	handle {
		root * /srv
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
